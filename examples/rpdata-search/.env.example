# Copy to ".env" and fill in. NEVER commit the real .env (it is gitignored).

# --- RP Data (CoreLogic) login ---
RPDATA_BASE_URL=https://rpp.corelogic.com.au/
RPDATA_USERNAME=
RPDATA_PASSWORD=

# --- Files ---
INPUT_CSV=./input.csv
OUTPUT_CSV=./output.csv

# --- LockedOn (optional) ---
# Paste a Zapier "Catch Hook" URL wired to Create Inspection/Enquiry to enable.
LOCKEDON_WEBHOOK_URL=
LOCKEDON_RECORD_TYPE=inspection

# --- Behaviour ---
# Set HEADLESS=false to watch the browser / handle MFA during login.
HEADLESS=true
SEARCH_DELAY_MS=2000
