# Copy to ".env" and fill in. NEVER commit the real .env (it is gitignored).

# --- LockedOn login ---
LOCKEDON_BASE_URL=https://app.lockedon.com/
LOCKEDON_USERNAME=
LOCKEDON_PASSWORD=

# --- RP Data (CoreLogic) login ---
RPDATA_BASE_URL=https://rpp.corelogic.com.au/
RPDATA_USERNAME=
RPDATA_PASSWORD=

# --- Output ---
REPORT_CSV=./report.csv

# --- Safety / behaviour ---
# WRITE_NOTES stays false (dry-run) until you've verified the selectors.
# Flip to true to actually save private notes in LockedOn.
WRITE_NOTES=false
# Set HEADLESS=false to watch the browser / handle MFA during login.
HEADLESS=true
ACTION_DELAY_MS=1500
